# Copiez en .env et renseignez les valeurs.

# --- Provider LLM (choisissez UN bloc) --------------------------------------

# Anthropic
LAB_MODEL=anthropic:claude-sonnet-4-6
ANTHROPIC_API_KEY=

# OpenAI
# LAB_MODEL=openai:gpt-4o
# OPENAI_API_KEY=

# Endpoint OpenAI-compatible (Azure, Ollama, vLLM, LM Studio, OpenRouter…)
# LAB_MODEL=openai:llama3
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1

# Topologie d'agent : single | supervisor | swarm
LAB_TOPOLOGY=single

# Couche outils : mcp (vrais serveurs MCP) | inproc (fallback laptop, zéro serveur)
MCP_MODE=mcp
MCP_HOST=127.0.0.1

# Affichage
LAB_TITLE=Agentathon Lab
TEAM_NAME=lab

# Garde-fous human-in-the-loop
HITL_WRITE=true
HITL_EDIT=true

# --- Persistance des conversations (optionnelle) ----------------------------
# Vide = MemorySaver en mémoire (perdu au restart). Définir pour persister.
# CHECKPOINT_DB=checkpoints.db

# --- Observabilité (optionnelle, pilotée par env) ---------------------------
# Arize Phoenix :
# PHOENIX_ENABLED=true
# PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006
# PHOENIX_PROJECT=agentathon
# PHOENIX_UI_URL=http://phoenix:6006
# LangSmith (alternative) :
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=...
# LANGSMITH_PROJECT=agentathon
